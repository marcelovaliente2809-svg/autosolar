{
  "name": "autosolar-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fastapi-dev": "python -m uvicorn api.index:app --reload --reload-dir api --reload-dir src --port 8000",
    "next-dev": "next dev",
    "dev": "concurrently -n next,api -c blue,green \"npm run next-dev\" \"npm run fastapi-dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
